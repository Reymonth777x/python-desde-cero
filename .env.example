NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=https://python-desde-cero.pythondesdecero.workers.dev

# Cloudflare Turnstile: la site key pública se configura en el Worker.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# El secreto de Turnstile se configura exclusivamente en Supabase Auth > Bot and Abuse Protection.
# No se guarda en Git ni se configura como variable del Worker.
