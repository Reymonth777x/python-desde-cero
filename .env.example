# Valores para desarrollo local. Copiar a .env.local; nunca subir .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional: llave pública de Cloudflare Turnstile para mostrar el widget local.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# El secreto de Turnstile se configura exclusivamente en Supabase Auth > Bot and Abuse Protection.
# Nunca guardes secretos del servidor, service-role keys ni tokens de Cloudflare en este archivo.
