# Local development defaults. The owner provides the dedicated DEV project values.
# Never put service_role, secret keys, Cloudflare tokens, or production credentials here.
NEXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-dev-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PYTHON_RUNNER_ORIGIN=http://127.0.0.1:8788

# Leave empty while CAPTCHA is disabled in Supabase DEV Auth.
# Only set the Cloudflare test sitekey when DEV Auth uses its matching test secret:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Never use Cloudflare test keys with production Supabase Auth.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
