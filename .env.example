NEXT_PUBLIC_SITE_URL=https://python-desdecero.com

# Cloudflare Turnstile (CAPTCHA nativo de Supabase Auth)
# Configurar en Supabase Dashboard: Auth > Bot and Abuse Protection > Enable CAPTCHA protection
# Claves de prueba de Turnstile (solo para desarrollo/e2e):
#   Site key: 1x00000000000000000000AA
#   Secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key